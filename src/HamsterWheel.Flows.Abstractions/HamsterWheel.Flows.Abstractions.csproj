<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>HamsterWheel.Flows</RootNamespace>
        <!--Clears the single TargetFramework inherited from the root Directory.Build.props so this
        multi-target project packs correctly (NU5026: cross-TFM assembly reference during pack)-->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HamsterWheel.CodeShare.Common" PrivateAssets="All"/>
        <PackageReference Include="HamsterWheel.CodeShare.NetStandard" PrivateAssets="All"/>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces"/>
    </ItemGroup>

</Project>
